NODE_ENV=development
PORT=3010
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=textify
SESSION_SECRET=replace-with-a-long-random-secret
# Deployment (Render/Vercel): use NODE_ENV=production, a 32+ character
# SESSION_SECRET, and TRUST_PROXY=1 so secure cookies work behind the proxy.
# TRUST_PROXY=1
